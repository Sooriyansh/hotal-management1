<div class="page-header d-flex justify-content-between align-items-center">
  <div>
    <h1>Booking <%= booking.bookingId %></h1>
    <p>Created on <%= moment(booking.createdAt).format('MMM DD, YYYY h:mm A') %></p>
  </div>
  <span class="badge badge-lg badge-<%= booking.status %>"><%= booking.status %></span>
</div>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header"><h5 class="mb-0">Booking Details</h5></div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-6">
            <p class="text-muted mb-1">Guest</p>
            <p class="fw-bold"><%= booking.guest ? booking.guest.name : 'N/A' %></p>
          </div>
          <div class="col-md-6">
            <p class="text-muted mb-1">Email</p>
            <p class="fw-bold"><%= booking.guest ? booking.guest.email : 'N/A' %></p>
          </div>
          <div class="col-md-6">
            <p class="text-muted mb-1">Check-in</p>
            <p class="fw-bold"><%= moment(booking.checkInDate).format('MMM DD, YYYY') %></p>
          </div>
          <div class="col-md-6">
            <p class="text-muted mb-1">Check-out</p>
            <p class="fw-bold"><%= moment(booking.checkOutDate).format('MMM DD, YYYY') %></p>
          </div>
          <div class="col-md-6">
            <p class="text-muted mb-1">Adults / Children</p>
            <p class="fw-bold"><%= booking.adults %> / <%= booking.children %></p>
          </div>
          <div class="col-md-6">
            <p class="text-muted mb-1">Source</p>
            <p class="fw-bold"><%= booking.source %></p>
          </div>
          <div class="col-12">
            <p class="text-muted mb-1">Rooms</p>
            <% booking.rooms.forEach(function(r) { %>
              <span class="badge bg-secondary me-1">Room <%= r.roomNumber %> · <%= r.roomType %></span>
            <% }); %>
          </div>
          <% if (booking.specialRequests) { %>
            <div class="col-12">
              <p class="text-muted mb-1">Special Requests</p>
              <p><%= booking.specialRequests %></p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card">
      <div class="card-header"><h5 class="mb-0">Payment</h5></div>
      <div class="card-body">
        <div class="d-flex justify-content-between mb-2">
          <span>Total Amount</span>
          <strong>₹<%= booking.totalAmount.toLocaleString() %></strong>
        </div>
        <div class="d-flex justify-content-between mb-2">
          <span>Paid</span>
          <strong>₹<%= booking.paidAmount.toLocaleString() %></strong>
        </div>
        <div class="d-flex justify-content-between mb-2">
          <span>Status</span>
          <span class="badge badge-<%= booking.paymentStatus %>"><%= booking.paymentStatus %></span>
        </div>
      </div>
    </div>
    <div class="card mt-3">
      <div class="card-header"><h5 class="mb-0">Actions</h5></div>
      <div class="card-body d-grid gap-2">
        <% if (['superadmin','manager','receptionist'].includes(currentUser.role)) { %>
          <% if (booking.status === 'confirmed') { %>
            <form action="/bookings/<%= booking._id %>/checkin" method="POST">
              <button class="btn btn-success w-100"><i class="fas fa-sign-in-alt me-1"></i>Check In</button>
            </form>
          <% } %>
          <% if (booking.status === 'checked-in') { %>
            <form action="/bookings/<%= booking._id %>/checkout" method="POST">
              <button class="btn btn-primary w-100"><i class="fas fa-sign-out-alt me-1"></i>Check Out</button>
            </form>
          <% } %>
        <% } %>
        <% if (['pending','confirmed'].includes(booking.status)) { %>
          <form action="/bookings/<%= booking._id %>/cancel" method="POST">
            <button class="btn btn-outline-danger w-100" onclick="return confirm('Cancel booking?')"><i class="fas fa-times me-1"></i>Cancel</button>
          </form>
        <% } %>
        <button class="btn btn-outline-secondary" onclick="window.print()"><i class="fas fa-print me-1"></i>Print Invoice</button>
      </div>
    </div>
  </div>
</div>
