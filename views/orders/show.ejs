<div class="page-header d-flex justify-content-between align-items-center">
  <div>
    <h1>Order <%= order.orderId %></h1>
    <p>Created on <%= moment(order.createdAt).format('MMM DD, YYYY h:mm A') %></p>
  </div>
  <span class="badge badge-lg badge-<%= order.status %>"><%= order.status %></span>
</div>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header"><h5 class="mb-0">Order Details</h5></div>
      <div class="card-body">
        <div class="row g-3">
          <% if (order.customer) { %>
            <div class="col-md-6">
              <p class="text-muted mb-1">Customer</p>
              <p class="fw-bold"><%= order.customer.name %></p>
            </div>
            <div class="col-md-6">
              <p class="text-muted mb-1">Phone</p>
              <p class="fw-bold"><%= order.customerPhone || order.customer.phone %></p>
            </div>
          <% } else { %>
            <div class="col-md-6">
              <p class="text-muted mb-1">Customer</p>
              <p class="fw-bold"><%= order.customerName %></p>
            </div>
            <div class="col-md-6">
              <p class="text-muted mb-1">Phone</p>
              <p class="fw-bold"><%= order.customerPhone %></p>
            </div>
          <% } %>
          <div class="col-12">
            <p class="text-muted mb-1">Items</p>
            <div class="list-group mb-3">
              <% order.items.forEach(function(item) { %>
                <div class="list-item d-flex justify-content-between align-items-center p-2 bg-light rounded">
                  <span><strong><%= item.name %></strong> × <%= item.quantity %></span>
                  <span class="text-muted">₹<%= (item.price * item.quantity).toFixed(2) %></span>
                </div>
              <% }); %>
            </div>
          </div>
          <div class="col-md-6">
            <p class="text-muted mb-1">Subtotal</p>
            <p class="fw-bold">₹<%= order.subtotal.toFixed(2) %></p>
          </div>
          <div class="col-md-6">
            <p class="text-muted mb-1">Tax (5%)</p>
            <p class="fw-bold">₹<%= order.tax.toFixed(2) %></p>
          </div>
          <div class="col-md-6">
            <p class="text-muted mb-1">Total</p>
            <p class="fw-bold fs-4">₹<%= order.total.toFixed(2) %></p>
          </div>
          <div class="col-12">
            <p class="text-muted mb-1">Special Instructions</p>
            <p class="fst-italic"><%= order.specialInstructions || 'None' %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card">
      <div class="card-header"><h5 class="mb-0">Order Actions</h5></div>
      <div class="card-body d-grid gap-2">
        <% if (['pending','confirmed','preparing'].includes(order.status)) { %>
          <form action="/orders/<%= order._id %>/status" method="POST">
            <input type="hidden" name="status" value="<%= order.status === 'pending' ? 'confirmed' : order.status === 'confirmed' ? 'preparing' : 'ready' %>">
            <button class="btn btn-primary w-100"><i class="fas fa-forward me-1"></i>Next Step</button>
          </form>
        <% } %>
        <% if (order.status === 'ready') { %>
          <form action="/orders/<%= order._id %>/status" method="POST">
            <input type="hidden" name="status" value="served">
            <button class="btn btn-success w-100"><i class="fas fa-utensils me-1"></i>Mark Served</button>
          </form>
        <% } %>
        <% if (order.paymentStatus === 'unpaid') { %>
          <form action="/orders/<%= order._id %>/pay" method="POST">
            <select name="paymentMethod" class="form-select mb-2" required>
              <option value="cash">Cash</option>
              <option value="upi">UPI</option>
              <option value="card">Card</option
            </select>
            <button class="btn btn-primary w-100"><i class="fas fa-credit-card me-1"></i>Collect Payment</button>
          </form>
        <% } %>
        <% if (['superadmin','manager'].includes(currentUser.role)) { %>
          <form action="/orders/<%= order._id %>" method="POST" onsubmit="return confirm('Delete order?')">
            <input type="hidden" name="_method" value="DELETE">
            <button class="btn btn-outline-danger w-100 mt-2"><i class="fas fa-trash me-1"></i>Cancel Order</button>
          </form>
        <% } %>
        <button class="btn btn-outline-secondary w-100 mt-2" onclick="window.print()"><i class="fas fa-print me-1"></i>Print Receipt</button>
      </div>
    </div>
  </div>
</div>
