<div class="page-header">
  <h1><i class="fas fa-user me-2"></i><%= customer.name %></h1>
  <p class="text-muted">Customer ID: #<%= String(customer._id).slice(-6) %></p>
</div>

<div class="row g-4">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header"><h5 class="mb-0">Profile</h5></div>
      <div class="card-body">
        <p><strong>Email:</strong> <%= customer.email %></p>
        <p><strong>Phone:</strong> <%= customer.phone || 'Not provided' %></p>
        <p><strong>Joined:</strong> <%= moment(customer.createdAt).format('MMM DD, YYYY') %></p>
        <p><strong>Loyalty Points:</strong> <%= customer.loyaltyPoints || 0 %></p>
      </div>
    </div>
    <div class="card">
      <div class="card-header"><h5 class="mb-0">Account</h5></div>
      <div class="card-body">
        <p><strong>Status:</strong> <span class="badge badge-<%= customer.isActive ? 'success' : 'secondary' %>"><%= customer.isActive ? 'Active' : 'Inactive' %></span></p>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-history me-2"></i>Booking History</h5>
        <a href="/bookings" class="btn btn-sm btn-outline-primary">View All</a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-sm mb-0">
            <thead><tr><th>ID</th><th>Dates</th><th>Status</th><th>Amount</th></tr></thead>
            <tbody>
              <% if (!customer.bookings || customer.bookings.length === 0) { %>
                <tr><td colspan="4" class="text-center text-muted py-3">No booking history</td></tr>
              <% } else {
                // In a real app, you would populate bookings here
                // For demo, showing placeholder
                customer.bookings.slice(0, 5).forEach(function(b) { %>
                  <tr>
                    <td><strong>BK<%= Math.floor(Math.random()*999999) %></strong></td>
                    <td><%= moment(b.checkInDate).format('MMM DD') %> - <%= moment(b.checkOutDate).format('MMM DD') %></td>
                    <td><span class="badge badge-<%= b.status %>"><%= b.status %></span></td>
                    <td>₹<%= b.totalAmount %></td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
