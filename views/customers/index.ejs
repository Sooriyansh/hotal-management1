<div class="page-header d-flex justify-content-between align-items-center">
  <div>
    <h1><i class="fas fa-users me-2"></i>Customers</h1>
    <p><%= customers.length %> total customer(s)</p>
  </div>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Joined</th><th>Bookings</th><th>Status</th><th>Action</th></tr></thead>
      <tbody>
        <% if (customers.length === 0) { %>
          <tr><td colspan="7" class="text-center text-muted py-4">No customers yet</td></tr>
        <% } %>
        <% customers.forEach(function(c) { %>
          <tr>
            <td><%= c.name %></td>
            <td><%= c.email %></td>
            <td><%= c.phone || '-' %></td>
            <td><%= moment(c.createdAt).format('MMM DD, YYYY') %></td>
            <td><%= c.bookings ? c.bookings.length : 0 %></td>
            <td><span class="badge badge-<%= c.isActive ? 'success' : 'secondary' %>"><%= c.isActive ? 'Active' : 'Inactive' %></span></td>
            <td>
              <a href="/customers/<%= c._id %>" class="btn btn-sm btn-outline-primary"><i class="fas fa-eye"></i></a>
              <% if (c.isActive) { %>
                <form action="/customers/<%= c._id %>/toggle" method="POST" onsubmit="return confirm('Deactivate customer?')">
                  <button class="btn btn-sm btn-outline-danger"><i class="fas fa-user-slash"></i></button>
                </form>
              <% } else { %>
                <form action="/customers/<%= c._id %>/toggle" method="POST" onsubmit="return confirm('Activate customer?')">
                  <button class="btn btn-sm btn-outline-success"><i class="fas fa-user-check"></i></button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
