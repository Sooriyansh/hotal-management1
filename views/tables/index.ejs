<div class="page-header d-flex justify-content-between align-items-center">
  <div>
    <h1><i class="fas fa-chair me-2"></i>Tables</h1>
    <p><%= tables.length %> total table(s)</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/tables/new" class="btn btn-outline-primary">Add Table</a>
    <button class="btn btn-success" id="refreshTables"><i class="fas fa-sync-alt"></i> Live Status</button>
  </div>
</div>

<div class="row g-3">
  <% tables.forEach(function(table) { %>
    <div class="col-md-3 col-sm-6">
      <div class="card table-card status-<%= table.status %>">
        <div class="table-image">
          <i class="fas fa-chair"></i>
          <span class="table-number"><%= table.tableNumber %></span>
          <span class="table-status-badge badge-<%= table.status %>"><%= table.status %></span>
        </div>
        <div class="card-body text-center">
          <p class="fw-bold mb-2">Capacity: <%= table.capacity %></p>
          <p class="text-muted mb-1"><i class="fas fa-layer-group me-1"></i>Floor <%= table.floor %></p>
          <% if (table.status === 'available') { %>
            <button class="btn btn-success btn-sm w-100" onclick="reserveTable('<%= table._id %>')">
              <i class="fas fa-check me-1"></i>Reserve
            </button>
          <% } else if (table.status === 'reserved') { %>
            <button class="btn btn-warning btn-sm w-100" onclick="occupyTable('<%= table._id %>')">
              <i class="fas fa-user me-1"></i>Occupy
            </button>
          <% } else if (table.status === 'occupied') { %>
            <button class="btn btn-danger btn-sm w-100" onclick="clearTable('<%= table._id %>')">
              <i class="fas fa-broom me-1"></i>Clear
            </button>
          <% } %>
        </div>
      </div>
    </div>
  <% }); %>
</div>

<script>
  async function reserveTable(id) {
    const res = await fetch(`/tables/${id}`, { method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify({status:'reserved'}) });
    if (res.ok) location.reload();
  }
  async function occupyTable(id) {
    const res = await fetch(`/tables/${id}`, { method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify({status:'occupied'}) });
    if (res.ok) location.reload();
  }
  async function clearTable(id) {
    const res = await fetch(`/tables/${id}`, { method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify({status:'available'}) });
    if (res.ok) location.reload();
  }
</script>
