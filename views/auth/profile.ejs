<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%- include('../partials/flash') %>

<main class="pt-24">
  <section class="section grid gap-8 lg:grid-cols-[420px_1fr]">
    <form class="glass-panel p-6" action="/auth/profile" method="post">
      <p class="eyebrow">Profile Management</p>
      <h1 class="mt-3 font-display text-4xl"><%= user.name %></h1>
      <div class="mt-6 grid gap-3">
        <label class="label">Avatar URL<input class="field" name="avatar" value="<%= user.avatar || '' %>" placeholder="https://example.com/avatar.jpg"></label>
        <label class="label">Name<input class="field" name="name" value="<%= user.name %>"></label>
        <label class="label">Phone<input class="field" name="phone"></label>
        <label class="label">Room Preference<select class="field" name="roomType"><option>Luxury Suite</option><option>Executive Room</option><option>Family Room</option></select></label>
        <label class="label">Cuisine Preference<select class="field" name="cuisine"><option>Indian</option><option>Italian</option><option>Chinese</option><option>Desserts</option></select></label>
        <label class="label">Pillow Preference<select class="field" name="pillow"><option>Soft</option><option>Medium</option><option>Firm</option></select></label>
        <button class="btn btn-gold w-full justify-center" type="submit"><i data-lucide="save" class="h-4 w-4"></i><span>Save</span></button>
      </div>
    </form>

    <div class="grid gap-5">
      <div class="glass-panel p-6">
        <h2 class="font-display text-3xl">Role Access</h2>
        <div class="mt-5 grid gap-3 md:grid-cols-3">
          <div class="metric"><span>Role</span><strong><%= user.role %></strong></div>
          <div class="metric"><span>Membership</span><strong><%= user.membershipTier || 'Guest' %></strong></div>
          <div class="metric"><span>JWT</span><strong>Active</strong></div>
        </div>
      </div>
      <div class="glass-panel p-6">
        <h2 class="font-display text-3xl">Activity Logs</h2>
        <div class="mt-5 grid gap-3">
          <% activityLogs.forEach((item) => { %>
            <div class="activity-row"><span><%= item.action %></span><small><%= item.at %></small></div>
          <% }) %>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
