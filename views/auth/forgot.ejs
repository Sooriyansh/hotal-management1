<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%- include('../partials/flash') %>

<main class="auth-page">
  <section class="auth-panel reveal">
    <p class="eyebrow">Forgot Password</p>
    <h1 class="mt-3 font-display text-5xl">Reset Access</h1>
    <p class="mt-4 text-sm leading-6 text-white/62">A reset token is prepared when MongoDB is connected. Email delivery can be attached through a mail provider.</p>
    <form class="mt-7 grid gap-3" action="/auth/forgot" method="post">
      <label class="label">Email<input class="field" type="email" name="email" required></label>
      <button class="btn btn-gold w-full justify-center" type="submit"><i data-lucide="key-round" class="h-4 w-4"></i><span>Request Reset</span></button>
    </form>
    <a href="/auth/login" class="mt-5 inline-block text-sm text-luxury-gold">Back to login</a>
  </section>
</main>

<%- include('../partials/scripts') %>
