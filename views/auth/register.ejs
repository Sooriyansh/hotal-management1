<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%- include('../partials/flash') %>

<main class="auth-page">
  <section class="auth-panel reveal">
    <p class="eyebrow">Register</p>
    <h1 class="mt-3 font-display text-5xl">Create Account</h1>
    <form class="mt-7 grid gap-3" action="/auth/register" method="post">
      <label class="label">Name<input class="field" name="name" required></label>
      <label class="label">Email<input class="field" type="email" name="email" required></label>
      <label class="label">Phone<input class="field" name="phone"></label>
      <label class="label">Role<select class="field" name="role">
        <option>Customer</option>
        <option>Receptionist</option>
        <option>Hotel Manager</option>
        <option>Restaurant Manager</option>
        <option>Chef</option>
        <option>Waiter</option>
        <option>Spa Manager</option>
        <option>Event Manager</option>
      </select></label>
      <label class="label">Password<input class="field" type="password" name="password" minlength="6" required></label>
      <button class="btn btn-gold w-full justify-center" type="submit"><i data-lucide="user-plus" class="h-4 w-4"></i><span>Create</span></button>
    </form>
    <a href="/auth/login" class="mt-5 inline-block text-sm text-luxury-gold">Already have an account</a>
  </section>
</main>

<%- include('../partials/scripts') %>
