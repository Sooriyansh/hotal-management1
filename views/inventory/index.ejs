<div class="page-header d-flex justify-content-between align-items-center">
  <div>
    <h1><i class="fas fa-boxes me-2"></i>Inventory</h1>
    <p><strong class="text-danger"><%= lowStock.length %></strong> low stock item(s)</p>
  </div>
  <a href="/inventory/new" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add Item</a>
</div>

<div class="alert alert-warning" role="alert">
  <i class="fas fa-exclamation-triangle me-2"></i>
  <strong>Low Stock Alert:</strong> <%= lowStock.length %> item(s) need restocking
</div>

<div class="row g-3">
  <% items.forEach(function(item) { %>
    <div class="col-md-4 col-lg-3">
      <div class="card inventory-card <%= item.quantity <= item.minStock ? 'border-danger' : '' %>">
        <div class="card-body">
          <h6 class="card-title mb-2"><%= item.itemName %></h6>
          <p class="mb-2"><span class="badge bg-secondary"><%= item.category %></span></p>
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="fs-5 fw-bold mb-1"><%= item.quantity %> <%= item.unit %></p>
              <small class="text-muted">Min: <%= item.minStock %> <%= item.unit %> | Max: <%= item.maxStock %> <%= item.unit %></small>
            </div>
            <div>
              <% if (item.quantity <= item.minStock) { %>
                <span class="badge bg-danger">LOW STOCK</span>
                <a href="/inventory/new" class="btn btn-sm btn-outline-danger mt-1"><i class="fas fa-plus-circle"></i></a>
              <% } else { %>
                <span class="badge bg-success">IN STOCK</span>
              <% } %>
            </div>
          </div>
          <div class="mt-2">
            <small class="text-muted d-block">Unit Price: ₹<%= item.unitPrice %></small>
          </div>
        </div>
      </div>
    </div>
  <% }); %>
</div>
