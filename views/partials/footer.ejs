<footer class="relative overflow-hidden border-t border-white/10 bg-black text-white">
  <!-- Decorative Background Element -->
  <div class="absolute -top-24 -left-24 h-96 w-96 rounded-full bg-luxury-gold/5 blur-3xl"></div>
  <div class="absolute -bottom-24 -right-24 h-96 w-96 rounded-full bg-luxury-gold/10 blur-3xl"></div>

  <div class="relative mx-auto grid max-w-7xl gap-12 px-6 py-16 sm:px-6 lg:grid-cols-[1.5fr_1fr_1fr_1fr] lg:px-8">
    <!-- Brand Section -->
    <div class="space-y-6">
      <div class="flex items-center gap-3 group cursor-pointer">
        <div class="grid h-12 w-12 place-items-center rounded-xl border border-luxury-gold/40 bg-luxury-gold/10 text-luxury-gold transition-all duration-300 group-hover:border-luxury-gold group-hover:bg-luxury-gold/20 group-hover:scale-110">
          <i data-lucide="gem" class="h-6 w-6"></i>
        </div>
        <span class="font-display text-2xl font-semibold tracking-tight text-white group-hover:text-luxury-gold transition-colors"><%= site.name %></span>
      </div>
      <p class="max-w-sm text-sm leading-relaxed text-white/60">
        <%= site.tagline %> <br/>
        Experience the pinnacle of luxury through intelligent booking, private dining, and precision hospitality.
      </p>
      <div class="flex gap-4">
        <a href="#" class="h-9 w-9 rounded-full border border-white/10 flex items-center justify-center text-white/60 hover:text-luxury-gold hover:border-luxury-gold transition-all duration-300 bg-white/5">
          <i data-lucide="facebook" class="h-4 w-4"></i>
        </a>
        <a href="#" class="h-9 w-9 rounded-full border border-white/10 flex items-center justify-center text-white/60 hover:text-luxury-gold hover:border-luxury-gold transition-all duration-300 bg-white/5">
          <i data-lucide="instagram" class="h-4 w-4"></i>
        </a>
        <a href="#" class="h-9 w-9 rounded-full border border-white/10 flex items-center justify-center text-white/60 hover:text-luxury-gold hover:border-luxury-gold transition-all duration-300 bg-white/5">
          <i data-lucide="twitter" class="h-4 w-4"></i>
        </a>
      </div>
    </div>

    <!-- Quick Links: Experiences -->
    <div class="space-y-6">
      <h3 class="font-display text-sm font-bold uppercase tracking-widest text-luxury-gold">Experiences</h3>
      <ul class="space-y-4">
        <li><a class="footer-link group flex items-center gap-2" href="/rooms">Rooms <i data-lucide="chevron-right" class="h-3 w-3 opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0"></i></a></li>
        <li><a class="footer-link group flex items-center gap-2" href="/restaurant">Restaurant <i data-lucide="chevron-right" class="h-3 w-3 opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0"></i></a></li>
        <li><a class="footer-link group flex items-center gap-2" href="/spa">Spa & Wellness <i data-lucide="chevron-right" class="h-3 w-3 opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0"></i></a></li>
        <li><a class="footer-link group flex items-center gap-2" href="/events">Events <i data-lucide="chevron-right" class="h-3 w-3 opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0"></i></a></li>
      </ul>
    </div>

    <!-- Quick Links: Smart Hotel -->
    <div class="space-y-6">
      <h3 class="font-display text-sm font-bold uppercase tracking-widest text-luxury-gold">Smart Hotel</h3>
      <ul class="space-y-4">
        <li><a class="footer-link group flex items-center gap-2" href="/concierge">AI Concierge <i data-lucide="chevron-right" class="h-3 w-3 opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0"></i></a></li>
        <li><a class="footer-link group flex items-center gap-2" href="/virtual-tour">Virtual Tours <i data-lucide="chevron-right" class="h-3 w-3 opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0"></i></a></li>
        <li><a class="footer-link group flex items-center gap-2" href="/memberships">VIP Membership <i data-lucide="chevron-right" class="h-3 w-3 opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0"></i></a></li>
        <li><a class="footer-link group flex items-center gap-2" href="/offers">Exclusive Offers <i data-lucide="chevron-right" class="h-3 w-3 opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0"></i></a></li>
      </ul>
    </div>

    <!-- Contact & Newsletter -->
    <div class="space-y-8">
      <div class="space-y-6">
        <h3 class="font-display text-sm font-bold uppercase tracking-widest text-luxury-gold">Contact Us</h3>
        <div class="space-y-4 text-sm text-white/60">
          <div class="flex items-center gap-3">
            <i data-lucide="phone" class="h-4 w-4 text-luxury-gold"></i>
            <span><%= site.phone %></span>
          </div>
          <div class="flex items-center gap-3">
            <i data-lucide="mail" class="h-4 w-4 text-luxury-gold"></i>
            <span><%= site.email %></span>
          </div>
          <div class="flex items-start gap-3">
            <i data-lucide="map-pin" class="h-4 w-4 text-luxury-gold mt-1"></i>
            <span><%= site.address %></span>
          </div>
        </div>
      </div>
      
      <div class="space-y-4">
        <h3 class="font-display text-sm font-bold uppercase tracking-widest text-white/80">Stay Updated</h3>
        <form action="/newsletter" method="post" class="relative flex max-w-xs gap-2">
          <input class="field w-full pr-12 py-2 bg-white/5 border-white/10 focus:border-luxury-gold transition-all" type="email" name="email" placeholder="Your email" required>
          <button class="absolute right-1 top-1 h-8 w-8 rounded-md bg-luxury-gold text-black hover:bg-luxury-gold/80 transition-all flex items-center justify-center" type="submit">
            <i data-lucide="send" class="h-4 w-4"></i>
          </button>
        </form>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10 px-6 py-8 text-center text-xs tracking-wide text-white/40">
    <p>&copy; <%= new Date().getFullYear() %> <%= site.name %>. All rights reserved. <span class="mx-2 opacity-30">|</span> Hospitality management demo platform.</p>
  </div>
</footer 
