<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%- include('../partials/flash') %>

<main class="pt-24">
  <section class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Loyalty Points / Referral Program / Rewards</p>
        <h1 class="font-display text-5xl md:text-6xl">VIP Membership System</h1>
      </div>
      <a href="/dashboard" class="btn btn-gold"><i data-lucide="badge-percent" class="h-4 w-4"></i><span>Rewards</span></a>
    </div>

    <div class="grid gap-5 lg:grid-cols-4">
      <% memberships.forEach((tier) => { %>
        <article class="membership-card reveal <%= tier.name === 'Diamond' ? 'diamond' : '' %>">
          <p class="eyebrow"><%= tier.points.toLocaleString() %> points</p>
          <h2 class="mt-3 font-display text-4xl"><%= tier.name %></h2>
          <p class="mt-4 text-3xl text-luxury-gold"><%= site.currency %><%= tier.price %></p>
          <div class="mt-6 grid gap-3">
            <% tier.benefits.forEach((benefit) => { %>
              <div class="flex gap-3 text-sm text-white/70"><i data-lucide="check" class="h-4 w-4 text-luxury-gold"></i><span><%= benefit %></span></div>
            <% }) %>
          </div>
          <button class="btn btn-ghost mt-8 w-full justify-center" type="button"><i data-lucide="crown" class="h-4 w-4"></i><span>Join</span></button>
        </article>
      <% }) %>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
