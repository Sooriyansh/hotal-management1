<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%- include('../partials/flash') %>

<main class="pt-24">
  <section class="page-hero" style="background-image: url('<%= room.image %>')">
    <div class="page-hero-inner">
      <p class="eyebrow reveal"><%= room.category %> / <%= room.size %> / <%= room.capacity %> Guests</p>
      <h1 class="reveal font-display text-5xl md:text-6xl"><%= room.name %></h1>
      <p class="reveal max-w-2xl text-white/70"><%= room.description %></p>
    </div>
  </section>

  <section class="section grid gap-8 lg:grid-cols-[1fr_420px]">
    <div>
      <div class="grid gap-4 md:grid-cols-3">
        <% room.gallery.forEach((image) => { %>
          <img class="h-56 w-full object-cover" src="<%= image %>" alt="<%= room.name %> gallery" loading="lazy">
        <% }) %>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        <div class="glass-panel p-6">
          <h2 class="font-display text-3xl">Amenities</h2>
          <div class="mt-5 grid gap-3">
            <% room.amenities.forEach((item) => { %>
              <div class="flex items-center gap-3 text-white/72"><i data-lucide="badge-check" class="h-5 w-5 text-luxury-gold"></i><span><%= item %></span></div>
            <% }) %>
          </div>
        </div>
        <div class="glass-panel p-6">
          <h2 class="font-display text-3xl">Smart Pricing</h2>
          <dl class="mt-5 grid gap-3 text-sm">
            <div class="flex justify-between"><dt class="text-white/55">Base rate</dt><dd><%= site.currency %><%= room.price %></dd></div>
            <div class="flex justify-between"><dt class="text-white/55">Seasonal rate</dt><dd><%= site.currency %><%= room.seasonalPrice %></dd></div>
            <div class="flex justify-between"><dt class="text-white/55">Discount engine</dt><dd><%= room.discount %>%</dd></div>
            <div class="flex justify-between"><dt class="text-white/55">Availability</dt><dd class="text-emerald-300"><%= room.availability %></dd></div>
          </dl>
        </div>
      </div>
    </div>

    <aside class="glass-panel h-fit p-5">
      <h2 class="font-display text-3xl">Book This Room</h2>
      <% if (user) { %>
        <form class="mt-4" action="/rooms/<%= room.slug %>/wishlist" method="post">
          <button class="btn btn-ghost w-full justify-center" type="submit"><i data-lucide="heart" class="h-4 w-4"></i><span>Add to Wishlist</span></button>
        </form>
      <% } %>
      <form class="mt-5 grid gap-3" action="/rooms/book" method="post">
        <input type="hidden" name="roomCategory" value="<%= room.name %>">
        <input type="hidden" name="price" value="<%= room.price %>">
        <label class="label">Guest Name<input class="field" name="guestName" value="<%= user?.name || '' %>" required></label>
        <label class="label">Email<input class="field" type="email" name="email" value="<%= user?.email || '' %>" required></label>
        <div class="grid grid-cols-2 gap-3">
          <label class="label">Check-In<input class="field" type="date" name="checkIn" required></label>
          <label class="label">Check-Out<input class="field" type="date" name="checkOut" required></label>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <label class="label">Guests<input class="field" type="number" min="1" name="guests" value="2"></label>
          <label class="label">Nights<input class="field" type="number" min="1" name="nights" value="1"></label>
        </div>
        <label class="label">Coupon<input class="field" name="couponCode" placeholder="SUITESPA15"></label>
        <button class="btn btn-gold w-full justify-center" type="submit"><i data-lucide="credit-card" class="h-4 w-4"></i><span>Generate Invoice</span></button>
      </form>
      <% if (user) { %>
        <form class="mt-5 grid gap-3 border-t border-white/10 pt-5" action="/reviews" method="post">
          <input type="hidden" name="targetType" value="Room">
          <label class="label">Rating<input class="field" type="number" name="rating" min="1" max="5" value="5"></label>
          <label class="label">Review<textarea class="field" name="comment" rows="3"></textarea></label>
          <button class="btn btn-ghost w-full justify-center" type="submit"><i data-lucide="star" class="h-4 w-4"></i><span>Leave Review</span></button>
        </form>
      <% } %>
    </aside>
  </section>

  <section class="section pt-0">
    <div class="section-heading">
      <p class="eyebrow">Compare</p>
      <h2>Other Rooms</h2>
    </div>
    <div class="grid gap-5 lg:grid-cols-3">
      <% relatedRooms.forEach((item) => { %>
        <a class="feature-card reveal" href="/rooms/<%= item.slug %>">
          <img src="<%= item.image %>" alt="<%= item.name %>" loading="lazy">
          <div class="p-5">
            <h3 class="font-display text-2xl"><%= item.name %></h3>
            <p class="mt-2 text-sm text-white/60"><%= site.currency %><%= item.price %> / night</p>
          </div>
        </a>
      <% }) %>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
