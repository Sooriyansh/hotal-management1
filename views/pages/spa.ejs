<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%- include('../partials/flash') %>

<main class="pt-24">
  <section class="page-hero" style="background-image: url('<%= services[0]?.image %>')">
    <div class="page-hero-inner">
      <p class="eyebrow reveal">Therapy Sessions / Private Suites / Scheduling</p>
      <h1 class="reveal font-display text-5xl md:text-6xl">Spa Management</h1>
      <p class="reveal max-w-2xl text-white/70">Book massage therapies, private spa suites, wellness memberships, and recovery rituals.</p>
    </div>
  </section>

  <section class="section grid gap-8 lg:grid-cols-[1fr_380px]">
    <div class="grid gap-5 md:grid-cols-2">
      <% services.forEach((service) => { %>
        <article class="feature-card reveal">
          <img src="<%= service.image %>" alt="<%= service.name %>" loading="lazy">
          <div class="p-5">
            <p class="eyebrow"><%= service.duration %> minutes</p>
            <h2 class="mt-2 font-display text-3xl"><%= service.name %></h2>
            <p class="mt-3 text-2xl text-luxury-gold"><%= site.currency %><%= service.price %></p>
            <div class="mt-4 flex flex-wrap gap-2">
              <% service.inclusions.forEach((item) => { %><span class="mini-chip"><%= item %></span><% }) %>
            </div>
          </div>
        </article>
      <% }) %>
    </div>

    <form class="glass-panel h-fit p-5" action="/spa/book" method="post">
      <h2 class="font-display text-3xl">Schedule Spa</h2>
      <div class="mt-5 grid gap-3">
        <label class="label">Guest Name<input class="field" name="guestName" value="<%= user?.name || '' %>" required></label>
        <label class="label">Service<select class="field" name="serviceName"><% services.forEach((service) => { %><option><%= service.name %></option><% }) %></select></label>
        <label class="label">Date & Time<input class="field" type="datetime-local" name="scheduledAt" required></label>
        <label class="label">Suite Preference<select class="field" name="suitePreference"><option>Private Spa Suite</option><option>Wellness Lounge</option><option>Poolside Cabana</option></select></label>
        <input type="hidden" name="amount" value="<%= services[0]?.price || 220 %>">
        <button class="btn btn-gold w-full justify-center" type="submit"><i data-lucide="calendar-plus" class="h-4 w-4"></i><span>Book Therapy</span></button>
      </div>
    </form>
  </section>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
